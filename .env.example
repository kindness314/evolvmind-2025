# ═══════════════════════════════════════════
# EvolvMind — 环境变量配置模板
# ═══════════════════════════════════════════
#
# 复制本文件为 .env 并填入实际值：
#   cp .env.example .env
#
# 前端构建变量（VITE_ 前缀）在构建时编译进产物
# 服务端变量仅在 Vercel Serverless Functions 中可用

# ─── Supabase ──────────────────────────────
# Supabase 项目 ID（从项目 Settings > API 获取）
VITE_SUPABASE_PROJECT_ID=
# Supabase anon/public key（从项目 Settings > API 获取）
VITE_SUPABASE_ANON_KEY=

# ─── AI / MiniMax ──────────────────────────
# MiniMax API key（服务端环境变量，永不暴露到前端）
MINIMAX_API_KEY=
# MiniMax 对话 API key（与 MINIMAX_API_KEY 分开时使用；为空则退回 MINIMAX_API_KEY）
MINIMAX_CHAT_API_KEY=
# MiniMax 聊天模型（默认: abab6.5s-chat）
MINIMAX_MODEL=abab6.5s-chat
# MiniMax API base URL
MINIMAX_BASE_URL=https://api.edgefn.net/v1
# Embedding 模型（默认: BAAI/bge-m3）
MINIMAX_EMBEDDING_MODEL=BAAI/bge-m3
