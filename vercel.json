{
  "rewrites": [
    {
      "source": "/api/graph/(embed|backfill|search|topicize|classify-topics|disambiguate)",
      "destination": "/api/graph-ops?op=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
